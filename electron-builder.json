{
  "appId": "ai.titan.collective",
  "productName": "TITAN AI",
  "copyright": "Copyright © 2026 TITAN AI",
  "directories": {
    "output": "dist-electron-build",
    "buildResources": "build"
  },
  "publish": null,
  "electronVersion": "22.3.27",
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["ia32"]
      },
      {
        "target": "portable",
        "arch": ["ia32"]
      }
    ],
    "legalTrademarks": "TITAN AI Collective Intelligence"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "TITAN AI",
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-${version}-Portable-${arch}.${ext}"
  }
}
