{
  "name": "titan-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --target=node16 --outfile=dist-electron/main.cjs --external:electron && esbuild electron/preload.ts --bundle --platform=node --target=node16 --outfile=dist-electron/preload.cjs --external:electron && esbuild server.ts --bundle --platform=node --target=node16 --outfile=dist-electron/server.cjs --external:vite",
    "package:win32": "electron-builder --win --ia32 --config electron-builder.json",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron dist-electron-build server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "electron": "22.3.27",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "rolldown": "^1.2.14",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.4"
  }
}
